<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.openapifn</groupId>
        <artifactId>openapi-fn-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>openapi-fn-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>openapi-fn-maven-plugin</name>
    <description>Maven plugin: generates models, controllers, clients and controller tests from OpenAPI descriptions during the build</description>

    <prerequisites>
        <maven>3.9</maven>
    </prerequisites>

    <properties>
        <automatic-module-name>dev.openapifn.maven.plugin</automatic-module-name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.openapifn</groupId>
            <artifactId>openapi-fn-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>openapi-fn</goalPrefix>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
